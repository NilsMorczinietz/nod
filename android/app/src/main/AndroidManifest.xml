<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the user exempt Nod from battery optimization in one tap (Settings › Delivery). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".NodApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="${networkSecurityConfig}"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Nod"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Pairing links: nod://pair?relay=…&code=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nod" android:host="pair" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notifications.ActionReceiver"
            android:exported="false" />

        <!-- Simulated pushes for local tests (debug and -Pnod.localTest builds only).
             Protected by DUMP, which only adb shell holds. -->
        <receiver
            android:name=".push.DebugPushReceiver"
            android:enabled="${debugPushEnabled}"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.nilsmorczinietz.nod.debug.PUSH" />
            </intent-filter>
        </receiver>

        <service
            android:name=".push.NodMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Firebase is initialised at runtime from the relay's config (see PushRegistrar). -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />

        <!-- firebase-messaging 26: register()/onRegistered() (the installation-ID API) is off
             unless enabled here; without it register() throws "API disabled" and no token arrives. -->
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />

        <!-- Don't let the GMS barcode module download lazily on first scan. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />
    </application>
</manifest>
