{
  "$description": "Nod design tokens v4 – single source of truth for Android (Compose) and desktop (CSS). Mirrors the Pushary style reference (private build, by request): Geist type system, teal palette, surface shadows. See docs/design.md.",
  "version": 4,
  "color": {
    "light": {
      "background": "#F1F6F6",
      "card": "#FAFCFC",
      "popover": "#FFFFFF",
      "muted": "#E7ECEC",
      "secondary": "#E9F0F0",
      "accent": "#DDE7E6",
      "foreground": "#061414",
      "mutedForeground": "#425B5A",
      "primary": "#00595A",
      "primaryForeground": "#F5F9F9",
      "buttonPrimary": "#007273",
      "buttonPrimaryForeground": "#FFFFFF",
      "primaryGlow": "#00A4A4",
      "primaryGlowHover": "#72D0D0",
      "primaryDrop": "#062E2E26",
      "primaryDropHover": "#062E2E33",
      "rule": "#E7ECEC",
      "input": "#E5EDED",
      "ring": "#00595A",
      "destructive": "#D40924",
      "danger": "#D40924",
      "waiting": "#F99C00",
      "waitingText": "#B75000",
      "success": "#009767"
    },
    "dark": {
      "background": "#010707",
      "card": "#031010",
      "popover": "#051515",
      "muted": "#0A1414",
      "secondary": "#0A1919",
      "accent": "#0B1E1E",
      "foreground": "#EEF3F3",
      "mutedForeground": "#7B9595",
      "primary": "#00A4A4",
      "primaryForeground": "#010C0C",
      "buttonPrimary": "#007273",
      "buttonPrimaryForeground": "#FFFFFF",
      "primaryGlow": "#72D0D0",
      "primaryGlowHover": "#8ADBDB",
      "primaryDrop": "#00000073",
      "primaryDropHover": "#00000080",
      "rule": "#1B2323",
      "input": "#0C1919",
      "ring": "#00A4A4",
      "destructive": "#A20519",
      "danger": "#FF837B",
      "waiting": "#F99C00",
      "waitingText": "#FCBB00",
      "success": "#00BB7F"
    },
    "island": {
      "$note": "Desktop island: always black like a hardware notch, independent of theme.",
      "background": "#000000",
      "foreground": "#F2F5F5",
      "mutedForeground": "#8FA3A3",
      "pill": "#16201F",
      "secondaryButton": "#1F2C2C",
      "secondaryButtonEdge": "#2E3E3E",
      "rule": "#1B2323"
    }
  },
  "badge": {
    "$description": "rounded-md, px 6, py 2, text 12/500. approved: primary on primary/10 (dark /15); denied: danger on destructive/10 (dark /20); waiting: waitingText on waiting/10 + 8px dot; live: 6px primary dot, pulsing.",
    "radius": 8,
    "paddingX": 6,
    "paddingY": 2
  },
  "radius": { "base": 10, "sm": 6, "md": 8, "lg": 10, "xl": 14, "island": 22, "full": 999 },
  "spacing": { "xs": 4, "s": 8, "m": 12, "l": 16, "xl": 24, "xxl": 32, "xxxl": 48, "section": 96 },
  "shadow": {
    "light": {
      "surfaceSm": "inset 0 0 0 1px #FFFFFFE6, 0 0 1px #00000014, 0 1px 2px -1px #1417170D",
      "surface": "inset 0 0 0 1px #FFFFFFE6, 0 0 1px #0000001A, 0 1px 2px -1px #1417170A, 0 8px 20px -6px #1417170D, 0 16px 36px -12px #1417170D",
      "buttonPrimary": "0 2px 2px 0 #062E2E26, inset 0 1px 3px 2px #00A4A4",
      "buttonPrimaryHover": "0 3px 6px 0 #062E2E33, inset 0 1px 3px 2px #72D0D0",
      "buttonPrimaryActive": "inset 0 2px 6px rgba(0,0,0,0.4), 0 1px 2px rgba(6,46,46,0.2)",
      "buttonSecondary": "0 1px 2px 0 rgba(6,46,46,0.06)"
    },
    "dark": {
      "surfaceSm": "inset 0 0 0 1px #FFFFFF0F, 0 0 1px #00000066, 0 1px 2px -1px #00000066",
      "surface": "inset 0 0 0 1px #FFFFFF0F, 0 0 1px #00000080, 0 1px 2px -1px #00000073, 0 8px 20px -6px #00000080, 0 16px 36px -12px #0000008C",
      "buttonPrimary": "0 2px 2px 0 #00000073, inset 0 1px 3px 2px #72D0D0",
      "buttonPrimaryHover": "0 3px 6px 0 #00000080, inset 0 1px 3px 2px #8ADBDB",
      "buttonPrimaryActive": "inset 0 2px 6px rgba(0,0,0,0.4), 0 1px 2px rgba(6,46,46,0.2)",
      "buttonSecondary": "0 1px 2px 0 rgba(0,0,0,0.3)"
    },
    "island": "0 10px 30px -10px rgba(0,0,0,0.55)",
    "waitingOutline": "1px solid rgba(249,156,0,0.5)"
  },
  "type": {
    "family": {
      "sans": "Geist",
      "mono": "Geist Mono",
      "pixel": "Geist Pixel Square",
      "$note": "All SIL OFL 1.1, bundled. npm `geist` >= 1.9.2 ships dist/fonts/geist-pixel/GeistPixel-Square.woff2."
    },
    "h1": { "size": 40, "sizeLarge": 48, "weight": 400, "lineHeight": 1.1, "tracking": -0.022 },
    "h2": { "size": 28, "sizeLarge": 42, "weight": 300, "lineHeight": 1.1, "tracking": -0.022 },
    "h3": { "size": 20, "sizeLarge": 24, "weight": 300, "lineHeight": 1.3, "tracking": -0.01 },
    "heading": { "size": 16, "weight": 500, "lineHeight": 1.35, "tracking": -0.01 },
    "body": { "size": 15, "weight": 400, "lineHeight": 1.6, "tracking": 0 },
    "small": { "size": 14, "weight": 500, "lineHeight": 1.45, "tracking": 0 },
    "xs": { "size": 12, "weight": 500, "lineHeight": 1.4, "tracking": 0 },
    "eyebrow": {
      "family": "mono",
      "size": 11,
      "weight": 500,
      "uppercase": true,
      "tracking": 0.2,
      "color": "primary",
      "rule": { "width": 24, "height": 1, "color": "primary @ 30%", "gap": 10 }
    },
    "stat": { "family": "pixel", "size": 28, "weight": 500, "tabular": true, "tracking": -0.02 },
    "mono": { "family": "mono", "size": 12, "weight": 400, "lineHeight": 1.55 },
    "code": { "family": "mono", "size": 13, "weight": 400, "lineHeight": 1.55 }
  },
  "motion": {
    "enter": { "duration": 200, "translateY": 4, "easing": "cubic-bezier(0.23, 1, 0.32, 1)" },
    "button": { "duration": 300, "easing": "cubic-bezier(0.165, 0.84, 0.44, 1)" },
    "island": { "duration": 320, "easing": "cubic-bezier(0.16, 1, 0.3, 1)" },
    "livePulse": "opacity 1 → 0.5 → 1, 2s, motion-safe only"
  }
}
