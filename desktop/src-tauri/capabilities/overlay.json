{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "Notification overlay: show cards and answer requests.",
  "windows": ["overlay"],
  "permissions": [
    "core:event:default",
    "allow-snapshot",
    "allow-resolve",
    "allow-list-items",
    "allow-set-mode",
    "allow-set-shortcuts",
    "allow-focus-island",
    "allow-release-focus",
    "allow-log-error",
    "allow-overlay-layout",
    "allow-open-main"
  ]
}
