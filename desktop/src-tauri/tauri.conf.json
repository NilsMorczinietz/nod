{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nod",
  "version": "../package.json",
  "identifier": "io.github.nilsmorczinietz.nod",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nod",
        "url": "index.html",
        "width": 920,
        "height": 680,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "focus": false
      },
      {
        "label": "overlay",
        "title": "Nod overlay",
        "url": "overlay.html",
        "width": 480,
        "height": 120,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Answer Claude Code from your desktop",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "../installer/header.bmp",
        "sidebarImage": "../installer/sidebar.bmp",
        "installerHooks": "../installer/hooks.nsh",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExQTc0MTQzMkYxMDk5MTEKUldRUm1SQXZRMEduRWRydEVDMHNRNjRYYTJuUWJVZzNTczF0cldqRUlFNDRnTnZDVFk3Tk1lVlYK",
      "endpoints": [
        "https://github.com/NilsMorczinietz/nod/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
